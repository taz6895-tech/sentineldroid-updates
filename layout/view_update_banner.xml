<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1A2E4A"
        android:padding="14dp"
        android:layout_marginBottom="12dp">

        <!-- Pulsing blue left border accent -->
        <View
            android:layout_width="match_parent"
            android:layout_height="2dp"
            android:background="@color/primary"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tv_update_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🆕 Update Available"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:layout_marginBottom="2dp"/>

        <TextView
            android:id="@+id/tv_update_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="v1.0 → v1.1"
            android:textSize="12sp"
            android:textColor="#90CAF9"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/tv_update_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="What's new..."
            android:textSize="12sp"
            android:textColor="#B0BEC5"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_update_download"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:text="⬇️ Download Update"
                android:textSize="12sp"
                android:backgroundTint="@color/primary"
                android:textColor="@android:color/white"
                android:layout_marginEnd="8dp"/>

            <Button
                android:id="@+id/btn_update_dismiss"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Later"
                android:textSize="12sp"
                android:backgroundTint="#2A3A4A"
                android:textColor="#90CAF9"/>

        </LinearLayout>

    </LinearLayout>

</merge>
